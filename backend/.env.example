# Copy to backend/.env and adjust. Every value below is a safe LOCAL default;
# none of them are real secrets. Never commit backend/.env.

ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://opspilot:opspilot@localhost:5433/opspilot
CORS_ORIGINS=["http://localhost:3000"]

# Generate a real one for any shared deployment: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0123456789
COOKIE_SECURE=false

# --- AWS services (S3, SQS, CloudWatch) ---
# Default: LocalStack (free, local). Nothing in OpsPilot requires a real AWS account.
#   AWS_ENDPOINT_URL set    -> everything goes to that endpoint with the dummy keys below.
#   AWS_ENDPOINT_URL=       (empty) -> real AWS, credentials from boto3's standard chain
#                           (AWS_PROFILE, ~/.aws, SSO, or a task role). The dummy keys are then ignored.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Local models via Ollama (free). To use OpenAI instead, set LLM_BASE_URL=https://api.openai.com/v1,
# LLM_API_KEY=<your key>, LLM_MODEL / EMBEDDING_MODEL / EMBEDDING_DIM accordingly, and LLM_PROMPT_SUFFIX=
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=opspilot-qwen3-8b   # created from docker/ollama/Modelfile (16K context)
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# Optional cross-encoder reranking (needs: uv sync --group rerank)
RERANK_ENABLED=false

# --- GitHub MCP server (read ONLY by `python -m mcp_servers.github.server`) ---
# Optional. Left empty, the server still starts and every GitHub tool answers "GitHub is not
# configured"; investigations then skip GitHub and say so in the report.
# Fine-grained token: only your chosen repo; Contents, Metadata, Pull requests = Read-only.
GITHUB_TOKEN=
# owner/name of the repositories the server may read (comma-separated)
GITHUB_ALLOWED_REPOS=

# --- CloudWatch MCP server ---
# Default: LocalStack with the synthetic demo incident (scripts/seed_cloudwatch.py).
# Only these log groups / metric namespaces can ever be read (the workspace integration narrows further).
CW_ALLOWED_LOG_GROUPS=/ecs/orders-api
CW_ALLOWED_NAMESPACES=OpsPilot/OrdersApi
# To read REAL CloudWatch while S3/SQS stay on LocalStack, uncomment (read-only IAM permissions:
# logs:FilterLogEvents, logs:DescribeLogGroups, cloudwatch:GetMetricData, cloudwatch:ListMetrics,
# cloudwatch:DescribeAlarms, cloudwatch:DescribeAlarmHistory):
# CW_AWS_ENDPOINT_URL=          # empty = real AWS for the CloudWatch server only
# CW_AWS_REGION=us-east-1
# CW_AWS_PROFILE=opspilot-readonly   # a named profile in ~/.aws; beats the dummy keys above
